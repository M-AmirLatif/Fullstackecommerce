extends layout

block content
  .admin-hero(data-reveal="up")
    .admin-hero-inner
      .admin-hero-text
        h1 ⚡ Admin Control Dashboard
        p Real-time storefront metrics, catalog management, and order fulfillment.
      .admin-hero-actions
        a.btn(href="/admin/products/add" style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); font-weight: 700;") ➕ Add Product
        a.btn.btn-outline(href="/admin/orders" style="font-weight: 600;") 📋 View Orders
        a.btn.btn-outline(href="/" style="font-weight: 600;") 🏠 Visit Store

  // Dynamic Real-Time Stats Section
  .stats-grid(data-stagger="70")
    .stat-card(data-reveal="scale")
      .stat-header
        .stat-label Total Products
        span.stat-icon 📦
      .stat-value #{productCount !== undefined ? productCount : 0}
      .stat-meta In active store catalog

    .stat-card.secondary(data-reveal="scale")
      .stat-header
        .stat-label Total Orders Placed
        span.stat-icon 🛒
      .stat-value #{orderCount !== undefined ? orderCount : 0}
      .stat-meta Processed customer orders

    .stat-card.success(data-reveal="scale")
      .stat-header
        .stat-label Total Store Revenue
        span.stat-icon 💰
      .stat-value Rs. #{((totalRevenue || 0)).toLocaleString()}
      .stat-meta ($#{(totalRevenue || 0).toFixed(2)})

    .stat-card.warning(data-reveal="scale")
      .stat-header
        .stat-label Pending / Processing
        span.stat-icon ⏳
      .stat-value #{pendingOrdersCount !== undefined ? pendingOrdersCount : 0}
      .stat-meta Orders awaiting shipment

  // Quick Action Buttons
  .card(data-reveal="up" style="background: rgba(8, 22, 40, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); margin-bottom: 2rem; border-radius: 16px; padding: 1.5rem;")
    h3(style="margin-top: 0; margin-bottom: 1rem; color: #fff; font-size: 1.15rem;") 🚀 Quick Management Shortcuts
    .action-buttons(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;")
      a.btn(href="/admin/products/add" style="justify-content: center; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); font-weight: 700;") ➕ Add Product
      a.btn(href="/admin/products" style="justify-content: center; background: rgba(255, 255, 255, 0.08); font-weight: 600;") 📦 Manage Catalog
      a.btn(href="/admin/orders" style="justify-content: center; background: rgba(255, 255, 255, 0.08); font-weight: 600;") 📋 View All Orders
      a.btn.btn-outline(href="/" style="justify-content: center; font-weight: 600;") 🏠 Front Storefront

  // Recent Orders Table
  .card(data-reveal="up" style="background: rgba(8, 22, 40, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); margin-bottom: 2rem; border-radius: 16px; padding: 1.5rem;")
    .section-head(style="margin-top: 0; margin-bottom: 1.25rem;")
      h3(style="margin: 0; color: #fff; font-size: 1.2rem;") 📋 Recent Customer Orders
      a.section-link(href="/admin/orders") View All Orders →
    
    if !recentOrders || recentOrders.length === 0
      p.text-muted(style="text-align: center; padding: 2rem;") No orders placed yet.
    else
      .table-container
        table
          thead
            tr
              th Order Ref
              th Customer
              th Amount
              th Status
              th Date
              th Actions
          tbody
            each order in recentOrders
              tr
                td
                  strong ##{order._id.toString().slice(-6).toUpperCase()}
                td
                  strong= order.customerName || 'Customer'
                  if order.email
                    br
                    small.text-muted= order.email
                td
                  strong(style="color: #f97316; font-size: 0.98rem; font-weight: 800;") Rs. #{(order.totalAmount || 0).toLocaleString()}
                td
                  if order.status === 'Paid' || order.status === 'Confirmed'
                    span.badge.badge-paid(style="background: #10b981; color: #ffffff; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 999px; display: inline-block; font-size: 0.78rem; letter-spacing: 0.04em; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.35);")= order.status
                  else if order.status === 'Delivered'
                    span.badge.badge-delivered(style="background: #059669; color: #ffffff; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 999px; display: inline-block; font-size: 0.78rem; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.35);")= order.status
                  else if order.status === 'Shipped'
                    span.badge.badge-shipped(style="background: #0284c7; color: #ffffff; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 999px; display: inline-block; font-size: 0.78rem; box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35);")= order.status
                  else if order.status === 'Cancelled'
                    span.badge.badge-cancelled(style="background: #ef4444; color: #ffffff; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 999px; display: inline-block; font-size: 0.78rem; box-shadow: 0 2px 8px rgba(239, 68, 68, 0.35);")= order.status
                  else
                    span.badge.badge-pending(style="background: #f59e0b; color: #ffffff; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 999px; display: inline-block; font-size: 0.78rem; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);")= order.status || 'Pending'
                td(style="white-space: nowrap; font-size: 0.88rem; color: rgba(255,255,255,0.8);")= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                td
                  .action-buttons(style="display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap;")
                    if order.status === 'Paid' || order.status === 'Confirmed' || order.status === 'Pending'
                      form(method="POST", action=`/admin/orders/${order._id}/ship`, style="display:inline; margin: 0;")
                        button.btn(type="submit", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: #0284c7; color: #ffffff; border: 1px solid #0369a1; border-radius: 8px; cursor: pointer;") 🚚 Ship
                    if order.status === 'Shipped'
                      form(method="POST", action=`/admin/orders/${order._id}/deliver`, style="display:inline; margin: 0;")
                        button.btn(type="submit", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: #059669; color: #ffffff; border: 1px solid #047857; border-radius: 8px; cursor: pointer;") ✅ Deliver
                    a.btn.btn-outline(href="/admin/orders", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: rgba(255, 255, 255, 0.08); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px;") Details

  // Recent Catalog Products
  .card(data-reveal="up" style="background: rgba(8, 22, 40, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 1.5rem;")
    .section-head(style="margin-top: 0; margin-bottom: 1.25rem;")
      h3(style="margin: 0; color: #fff; font-size: 1.2rem;") 📦 Catalog Overview
      a.section-link(href="/admin/products") Manage All Products →
    
    if !recentProducts || recentProducts.length === 0
      p.text-muted(style="text-align: center; padding: 2rem;") No products found in catalog.
    else
      .table-container
        table
          thead
            tr
              th Product
              th Category
              th Stock
              th Price
              th Actions
          tbody
            each prod in recentProducts
              tr
                td
                  strong= prod.name
                  if prod.model
                    br
                    small.text-muted Model: #{prod.model}
                td
                  span.badge= prod.category || 'General'
                td
                  if prod.inStock !== false && prod.stock > 0
                    span.badge.success #{prod.stock} in stock
                  else
                    span.badge.danger Out of stock
                td
                  strong.text-primary Rs. #{(prod.price || 0).toLocaleString()} ($#{(prod.price || 0).toFixed(2)})
                td
                  .action-buttons
                    a.btn(href=`/admin/products/edit/${prod._id}`, style="padding: 0.4rem 0.85rem; font-size: 0.82rem;") ✍️ Edit
