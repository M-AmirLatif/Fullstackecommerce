extends layout

block content
  .admin-header(data-reveal="up")
    div
      h1 📋 Orders Management
      p(style="color: var(--muted); margin-top: 0.25rem;") Track customer orders, update delivery progress, and handle cancellations.
    .admin-header-actions
      a.btn(href="/admin" style="font-weight: 600;") 📊 Dashboard

  .card(data-reveal="up" style="background: rgba(8, 22, 40, 0.9); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 1.5rem;")
    h3(style="margin-top: 0; margin-bottom: 1.25rem; color: #fff; font-size: 1.2rem;") All Customer Orders
    
    if !orders || orders.length === 0
      p.text-center.text-muted(style="padding: 3rem 1rem;") No customer orders placed yet.
    else
      .table-container
        table
          thead
            tr
              th Order ID
              th Customer
              th Contact / Shipping
              th Total Amount
              th Status
              th Date
              th Quick Actions
          tbody
            each order in orders
              tr
                td
                  strong ##{order._id.toString().slice(-6).toUpperCase()}
                td
                  strong= order.customerName || 'Customer'
                  if order.email
                    br
                    small.text-muted= order.email
                td
                  if order.shipping
                    span #{order.shipping.city || ''}, #{order.shipping.state || ''}
                    if order.shipping.phone
                      br
                      small.text-muted 📞 #{order.shipping.phone}
                  else
                    span.text-muted Direct Purchase
                td
                  strong.text-primary Rs. #{(order.totalAmount || 0).toLocaleString()}
                  br
                  small.text-muted ($#{(order.totalAmount || 0).toFixed(2)})
                td
                  if order.status === 'Paid' || order.status === 'Confirmed'
                    span.badge.badge-paid(style="background: #10b981; color: #ffffff; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px; display: inline-block; font-size: 0.76rem; letter-spacing: 0.04em;")= order.status
                  else if order.status === 'Delivered'
                    span.badge.badge-delivered(style="background: #059669; color: #ffffff; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px; display: inline-block; font-size: 0.76rem;")= order.status
                  else if order.status === 'Shipped'
                    span.badge.badge-shipped(style="background: #0284c7; color: #ffffff; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px; display: inline-block; font-size: 0.76rem;")= order.status
                  else if order.status === 'Cancelled'
                    span.badge.badge-cancelled(style="background: #ef4444; color: #ffffff; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px; display: inline-block; font-size: 0.76rem;")= order.status
                  else
                    span.badge.badge-pending(style="background: #f59e0b; color: #ffffff; font-weight: 700; padding: 0.35rem 0.75rem; border-radius: 999px; display: inline-block; font-size: 0.76rem;")= order.status || 'Pending'
                td(style="white-space: nowrap; font-size: 0.88rem; color: rgba(255,255,255,0.8);")= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                td
                  .action-buttons(style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;")
                    if order.status === 'Paid' || order.status === 'Confirmed' || order.status === 'Pending'
                      form(method="POST", action=`/admin/orders/${order._id}/ship`, style="display:inline; margin: 0;")
                        button.btn(type="submit", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: #0284c7; color: #ffffff; border: 1px solid #0369a1; border-radius: 8px; cursor: pointer; box-shadow: 0 2px 6px rgba(2, 132, 199, 0.3);") 🚚 Ship
                    if order.status === 'Shipped'
                      form(method="POST", action=`/admin/orders/${order._id}/deliver`, style="display:inline; margin: 0;")
                        button.btn(type="submit", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: #059669; color: #ffffff; border: 1px solid #047857; border-radius: 8px; cursor: pointer; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);") ✅ Deliver
                    if order.status === 'Pending' || order.status === 'Paid' || order.status === 'Confirmed' || order.status === 'Shipped'
                      form(method="POST", action=`/admin/orders/${order._id}/cancel`, style="display:inline; margin: 0;", onclick="return confirm('Are you sure you want to cancel order #" + order._id.toString().slice(-6).toUpperCase() + "?')")
                        button.btn.btn-danger(type="submit", style="padding: 0.45rem 0.85rem; font-size: 0.82rem; font-weight: 700; background: #dc2626 !important; color: #ffffff !important; border: 1px solid #ef4444 !important; border-radius: 8px; cursor: pointer; box-shadow: 0 2px 6px rgba(220, 38, 38, 0.35);") ❌ Cancel
