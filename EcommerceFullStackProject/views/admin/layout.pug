doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    if csrfToken
      meta(name="csrf-token" content=csrfToken)
    title Tech Innovation Store - Admin Panel
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap")
    // Favicon link
    link(rel="icon" href="/images/favicon.png" type="image/png")
    // Stylesheets
    link(rel="stylesheet", href="/stylesheets/style.css?v=20261006-tech-v3")
    link(rel="stylesheet", href="/stylesheets/responsive.css?v=20261006-tech-v3")

  body
    .admin-layout
      // Sidebar Section
      aside.admin-sidebar
        h3 ⚡ Tech Innovation Admin
        nav.admin-nav
          a.nav-item(href="/admin") 📊 Dashboard
          a.nav-item(href="/admin/products") 📦 Products
          a.nav-item(href="/admin/products/add") ➕ Add Product
          a.nav-item(href="/admin/orders") 📋 Orders
          a.nav-item(href="/") 🏠 Back to Store

      // Main Content Section
      main.admin-content
        block content

    block scripts
    script(src="/js/csrf.js")
    script(src="/js/admin-ai.js")
    script(src="/js/motion.js")
