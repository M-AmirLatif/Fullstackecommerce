extends ../layout

block content
  section.hero.hero-tech-showcase
    .hero-glow-blob.hero-glow-1
    .hero-glow-blob.hero-glow-2
    .hero-grid-pattern
    .hero-inner
      .hero-left
        .hero-pill-badge(data-reveal="fade")
          span.live-dot
          span.pill-text ⚡ OFFICIAL TECH STORE • WE DELIVER BEST 🇵🇰

        h1.hero-title(data-reveal="up")
          span.hero-title-main Next-Gen Tech.
          span.hero-title-highlight Unmatched Innovation.

        p.hero-sub(data-reveal="up" data-reveal-delay="90")
          | Discover cutting-edge smart gadgets, flagship audio, and premium accessories engineered for high performance. 100% genuine quality delivered to your doorstep.

        .hero-features-strip(data-reveal="up" data-reveal-delay="130")
          .hero-feat-item
            span.feat-icon 🚀
            span.feat-label Express Delivery Across PK
          .hero-feat-item
            span.feat-icon 🛡️
            span.feat-label 100% Genuine & Tested
          .hero-feat-item
            span.feat-icon ⭐
            span.feat-label 4.9/5 Rating (5K+ Happy Customers)

        .hero-actions(data-reveal="up" data-reveal-delay="170")
          a.btn.btn-hero-primary(href='/shop')
            span.btn-text Explore All Products
            span.btn-arrow →
          a.btn.btn-hero-secondary(href='/shop?featured=true')
            span.btn-fire 🔥
            span.btn-text Flash Deals (Up to 30% Off)

        .hero-popular-capsule(data-reveal="up" data-reveal-delay="230")
          .popular-header
            span.popular-fire ⚡
            span.popular-title Popular Categories:
          .popular-grid
            a.popular-card(href='/shop?category=Smartphones')
              span.pop-icon 📱
              span.pop-label Smartphones
            a.popular-card(href='/shop?category=Audio')
              span.pop-icon 🎧
              span.pop-label Audio & Sound
            a.popular-card(href='/shop?category=Wearables')
              span.pop-icon ⌚
              span.pop-label Smartwatches
            a.popular-card(href='/shop?sort=rating')
              span.pop-icon ⭐
              span.pop-label Top Rated

      .hero-right(data-reveal="up" data-reveal-delay="140")
        .hero-glass-card
          .card-badge-top
            span.deal-tag 🔥 HOT TECH PICK
            span.discount-pill -30% OFF
          .card-media-wrap
            img.card-img-hero(src='/images/webcam.jpg', alt='Featured Tech Gadget', loading='eager')
            .card-floating-badge
              span.badge-pulse
              span 4K Ultra HD
          .card-info-wrap
            p.card-kicker ⚡ Trending This Week
            h3.card-title 4K Pro Ultra-Clear StreamCam
            p.card-specs Dual AI Mics • HDR 60FPS • Plug & Play
            .card-price-row
              .price-group
                span.price-curr $159.99
                span.price-old $219.99
              if user && user.role === 'admin'
                a.btn-claim(href='/admin/products' style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important; border-color: #0284c7 !important; padding: 0.42rem 0.85rem; font-size: 0.82rem;") ⚙️ Manage
              else
                a.btn-claim(href='/claim-deal' style="padding: 0.42rem 0.85rem; font-size: 0.82rem;") Claim Deal →

  section.container
    .section-head(data-reveal="fade")
      h2 Featured Products
      a.section-link(href='/shop') See All ->

    if (products && products.length > 0)
      .products-grid(data-stagger="70")
        each product in products.slice(0, 12)
          - const ratingValue = Number(product.rating || 0)
          - const reviewCount = Number(product.reviewCount || 0)
          - const safeReviewCount = reviewCount > 0 ? reviewCount : 128
          - const colorList = product.colors && product.colors.length ? product.colors : ['#111827', '#2563eb', '#f8fafc']
          - const priceValue = Number(product.price || 0)
          - const originalValue = Number(product.originalPrice || 0)
          - const hasDiscount = originalValue > priceValue && originalValue > 0
          - const discountPct = hasDiscount ? Math.round(((originalValue - priceValue) / originalValue) * 100) : 0
          - const roundedRating = Math.max(0, Math.min(5, Math.round(ratingValue)))
          - const isAvailable = product.inStock !== false && Number(product.stock || 0) > 0
          .product(data-reveal="scale")
            .product-media
              if product.image && product.image.length > 0
                img(src=imageUrl(product.image), alt=product.name, loading="lazy", decoding="async", referrerpolicy="no-referrer")
              else
                span.no-image []

              if product.category
                span.badge.badge-surface= product.category
              if !isAvailable
                span.badge.badge-danger Out of stock

            .product-body
              .product-top
                .product-colors
                  each color, idx in colorList.slice(0, 4)
                    span.swatch(style=`--swatch:${color}`)
                  if colorList.length > 4
                    span.swatch.more +#{colorList.length - 4}

                .product-rating
                  span.rating-stars= '★★★★★'.slice(0, roundedRating) + '☆☆☆☆☆'.slice(0, 5 - roundedRating)
                  span.rating-count (#{safeReviewCount})

              h3= product.name

              .price-row
                span.price-current $#{priceValue.toFixed(2)}
                if hasDiscount
                  span.price-original $#{originalValue.toFixed(2)}
                  span.price-discount -#{discountPct}%

              .product-actions
                a.btn.btn-outline(href='/product/' + product._id) View Details
                if !user || user.role !== 'admin'
                  if isAvailable
                    form(action='/cart/add', method='POST')
                      input(type='hidden', name='productId', value=product._id)
                      button.btn(type='submit') Add to Cart
                  else
                    button.btn(type='button' disabled) Out of Stock
    else
      .card
        p.text-center No products available yet. Check back soon.

  section.container
    .section-head(data-reveal="fade")
      h2 Shop by Category
    .categories-grid(data-stagger="80")
      .category-card(data-reveal="up")
        .category-img-wrapper
          img(src='/images/wireless_headphones.webp', alt='Electronics', loading="lazy", decoding="async")
        .category-content
          h3 Electronics
          p Premium tech and gadgets
          a.btn-category(href='/shop?category=Electronics') Shop Now ->

      .category-card(data-reveal="up")
        .category-img-wrapper
          img(src='/images/jacket.jpg', alt='Clothing', loading="lazy", decoding="async")
        .category-content
          h3 Clothing
          p Fashion and apparel
          a.btn-category(href='/shop?category=Clothing') Shop Now ->

      .category-card(data-reveal="up")
        .category-img-wrapper
          img(src='/images/sunglasses.webp', alt='Accessories', loading="lazy", decoding="async")
        .category-content
          h3 Accessories
          p Stylish accessories
          a.btn-category(href='/shop?category=Accessories') Shop Now ->

  section.container
    .section-head(data-reveal="fade")
      h2 Best Sellers
      a.section-link(href='/shop?sort=bestseller') See All ->

    if (bestSellers && bestSellers.length > 0)
      .products-grid(data-stagger="70")
        each product in bestSellers.slice(0, 8)
          - const ratingValue = Number(product.rating || 0)
          - const reviewCount = Number(product.reviewCount || 0)
          - const safeReviewCount = reviewCount > 0 ? reviewCount : 128
          - const colorList = product.colors && product.colors.length ? product.colors : ['#111827', '#2563eb', '#f8fafc']
          - const priceValue = Number(product.price || 0)
          - const originalValue = Number(product.originalPrice || 0)
          - const hasDiscount = originalValue > priceValue && originalValue > 0
          - const discountPct = hasDiscount ? Math.round(((originalValue - priceValue) / originalValue) * 100) : 0
          - const roundedRating = Math.max(0, Math.min(5, Math.round(ratingValue)))
          - const isAvailable = product.inStock !== false && Number(product.stock || 0) > 0
          .product(data-reveal="scale")
            .product-media
              if product.image && product.image.length > 0
                img(
                  src=imageUrl(product.image),
                  alt=product.name,
                  loading="lazy",
                  decoding="async",
                  referrerpolicy="no-referrer"
                )
              else
                span.no-image []

              if product.category
                span.badge.badge-surface= product.category
              if !isAvailable
                span.badge.badge-danger Out of stock

            .product-body
              .product-top
                .product-colors
                  each color, idx in colorList.slice(0, 4)
                    span.swatch(style=`--swatch:${color}`)
                  if colorList.length > 4
                    span.swatch.more +#{colorList.length - 4}

                .product-rating
                  span.rating-stars= '★★★★★'.slice(0, roundedRating) + '☆☆☆☆☆'.slice(0, 5 - roundedRating)
                  span.rating-count (#{safeReviewCount})

              h3= product.name

              .price-row
                span.price-current $#{priceValue.toFixed(2)}
                if hasDiscount
                  span.price-original $#{originalValue.toFixed(2)}
                  span.price-discount -#{discountPct}%

              .product-actions
                a.btn.btn-outline(href='/product/' + product._id) View Details
                if !user || user.role !== 'admin'
                  if isAvailable
                    form(action='/cart/add', method='POST')
                      input(type='hidden', name='productId', value=product._id)
                      button.btn(type='submit') Add to Cart
                  else
                    button.btn(type='button' disabled) Out of Stock
    else
      .card
        p.text-center No bestsellers available yet.

  section.container
    .promo-banner(data-reveal="up")
      h3 Exclusive Offer
      p Save 20% on your first purchase with code: WELCOME20
      a.btn(href='/shop') Shop Now
