extends ../layout

block content
  .auth-page
    .auth-shell(data-stagger="90")
      .auth-left(data-reveal="up")
        h1.auth-hero-title 👋 Welcome Back!
        p.auth-hero-sub Sign in to your account to manage your cart, checkout faster, and track your orders.
        .auth-perks
          .perk ✓ Fast and secure checkout
          .perk ✓ Real-time order tracking
          .perk ✓ Saved payment methods
          .perk ✓ Access to admin panel
          .perk ✓ Exclusive member deals

      .auth-card(data-reveal="scale")
        .auth-brand-badge(style="display: flex; justify-content: center; margin-bottom: 1rem;")
          .brand-logo-wrap(style="width: 48px; height: 48px; border-radius: 50%; padding: 2.5px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(249, 115, 22, 0.5);")
            img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        h2.auth-title Sign In
        p.auth-subtitle Login with your email and password

        if flash
          .flash(class=flash.type)= flash.text

        form.auth-form(action="/login" method="POST" autocomplete="off")
          if csrfToken
            input(type="hidden" name="_csrf" value=csrfToken)

          .auth-field
            label(for="email") 📧 Email Address
            input#email(type="email" name="email" list="saved-emails-list" placeholder="your@email.com" required autocomplete="off")
            datalist#saved-emails-list

          .auth-field
            label(for="password") 🔐 Password
            input#password(type="password" name="password" placeholder="••••••••" required autocomplete="new-password")

          p.auth-bottom(style="margin-top: -0.35rem; margin-bottom: 0.6rem;")
            a(href="/forgot-password") Forgot password?

          button.auth-submit(type="submit") 🔓 Sign In

        p.auth-bottom(style="margin-top: 1.5rem;")
          | Don't have an account? 
          a(href="/register") Create One

    script.
      (function() {
        var userInteracted = false;

        function wipePreload() {
          if (userInteracted) return;
          var em = document.getElementById('email');
          var pw = document.getElementById('password');
          if (em && document.activeElement !== em && !em.dataset.touched) em.value = '';
          if (pw && document.activeElement !== pw && !pw.dataset.touched) pw.value = '';
        }

        // Run wipe at multiple intervals to defeat delayed browser auto-injection on page load
        [0, 30, 80, 150, 300, 600, 1000].forEach(function(t) {
          setTimeout(wipePreload, t);
        });

        document.addEventListener('DOMContentLoaded', function() {
          var emailInput = document.getElementById('email');
          var passInput = document.getElementById('password');
          var datalist = document.getElementById('saved-emails-list');
          var form = document.querySelector('form.auth-form');

          function renderDatalist() {
            try {
              var stored = JSON.parse(localStorage.getItem('tech_saved_emails') || '[]');
              if (datalist && Array.isArray(stored) && stored.length > 0) {
                datalist.innerHTML = '';
                stored.forEach(function(em) {
                  if (em && typeof em === 'string' && em.trim()) {
                    var opt = document.createElement('option');
                    opt.value = em.trim();
                    datalist.appendChild(opt);
                  }
                });
              }
            } catch (e) {}
          }

          renderDatalist();

          function onEmailInteract() {
            userInteracted = true;
            if (emailInput) {
              emailInput.dataset.touched = 'true';
              emailInput.setAttribute('autocomplete', 'username');
              renderDatalist();
            }
          }

          function onPassInteract() {
            userInteracted = true;
            if (passInput) {
              passInput.dataset.touched = 'true';
              passInput.setAttribute('autocomplete', 'current-password');
            }
          }

          if (emailInput) {
            emailInput.addEventListener('focus', onEmailInteract);
            emailInput.addEventListener('click', onEmailInteract);
            emailInput.addEventListener('pointerdown', onEmailInteract);
            emailInput.addEventListener('input', onEmailInteract);
          }

          if (passInput) {
            passInput.addEventListener('focus', onPassInteract);
            passInput.addEventListener('click', onPassInteract);
            passInput.addEventListener('pointerdown', onPassInteract);
            passInput.addEventListener('input', onPassInteract);
          }

          if (form && emailInput) {
            form.addEventListener('submit', function() {
              try {
                var val = (emailInput.value || '').trim().toLowerCase();
                if (val && val.includes('@')) {
                  var stored = JSON.parse(localStorage.getItem('tech_saved_emails') || '[]');
                  if (!Array.isArray(stored)) stored = [];
                  stored = stored.filter(function(e) { return e !== val; });
                  stored.unshift(val);
                  stored = stored.slice(0, 5);
                  localStorage.setItem('tech_saved_emails', JSON.stringify(stored));
                }
              } catch (e) {}
            });
          }
        });

        window.addEventListener('load', wipePreload);
        window.addEventListener('pageshow', wipePreload);
      })();
