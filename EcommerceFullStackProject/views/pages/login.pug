extends ../layout

block content
  .auth-page
    .auth-shell(data-stagger="90")
      .auth-left(data-reveal="up")
        h1.auth-hero-title 👋 Welcome Back!
        p.auth-hero-sub Sign in to your account to manage your cart, checkout faster, and track your orders.
        .auth-perks
          .perk ✓ Fast and secure checkout
          .perk ✓ Real-time order tracking
          .perk ✓ Saved payment methods
          .perk ✓ Access to admin panel
          .perk ✓ Exclusive member deals

      .auth-card(data-reveal="scale")
        .auth-brand-badge(style="display: flex; justify-content: center; margin-bottom: 1rem;")
          .brand-logo-wrap(style="width: 48px; height: 48px; border-radius: 50%; padding: 2.5px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(249, 115, 22, 0.5);")
            img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        h2.auth-title Sign In
        p.auth-subtitle Login with your email and password

        if flash
          .flash(class=flash.type)= flash.text

        form.auth-form(action="/login" method="POST" autocomplete="on")
          if csrfToken
            input(type="hidden" name="_csrf" value=csrfToken)

          .auth-field
            label(for="email") 📧 Email Address
            input#email(type="email" name="email" placeholder="your@email.com" required autocomplete="username email")

          .auth-field
            label(for="password") 🔐 Password
            input#password(type="password" name="password" placeholder="••••••••" required autocomplete="current-password")

          p.auth-bottom(style="margin-top: -0.35rem; margin-bottom: 0.6rem;")
            a(href="/forgot-password") Forgot password?

          button.auth-submit(type="submit") 🔓 Sign In

        .quick-login-hints(style="margin-top: 1.25rem; padding: 0.85rem; background: rgba(255, 255, 255, 0.04); border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 12px;")
          p(style="margin: 0 0 0.5rem 0; font-size: 0.78rem; color: rgba(255,255,255,0.7); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;") ⚡ Quick Select Saved Account:
          .hints-btns(style="display: flex; gap: 0.5rem; flex-wrap: wrap;")
            button.btn.btn-outline(type="button" onclick="document.getElementById('email').value='admin123@gmail.com';document.getElementById('password').value='admin123';" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 8px;") 🛡️ Admin (admin123@gmail.com)
            button.btn.btn-outline(type="button" onclick="document.getElementById('email').value='amirlatif2288@gmail.com';document.getElementById('password').value='123456';" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 8px;") 👤 Customer (amirlatif2288@gmail.com)

        p.auth-bottom(style="margin-top: 1rem;")
          | Don't have an account? 
          a(href="/register") Create One
