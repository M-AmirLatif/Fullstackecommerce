extends ../layout

block content
  .auth-page
    .auth-shell(data-stagger="90")
      .auth-left(data-reveal="up")
        h1.auth-hero-title 👋 Welcome Back!
        p.auth-hero-sub Sign in to your account to manage your cart, checkout faster, and track your orders.
        .auth-perks
          .perk ✓ Fast and secure checkout
          .perk ✓ Real-time order tracking
          .perk ✓ Saved payment methods
          .perk ✓ Access to admin panel
          .perk ✓ Exclusive member deals

      .auth-card(data-reveal="scale")
        .auth-brand-badge(style="display: flex; justify-content: center; margin-bottom: 1rem;")
          .brand-logo-wrap(style="width: 48px; height: 48px; border-radius: 50%; padding: 2.5px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(249, 115, 22, 0.5);")
            img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        h2.auth-title Sign In
        p.auth-subtitle Login with your email and password

        if flash
          .flash(class=flash.type)= flash.text

        form.auth-form(action="/login" method="POST" autocomplete="off")
          if csrfToken
            input(type="hidden" name="_csrf" value=csrfToken)

          //- Decoy hidden inputs to absorb browser autofill
          input(type="text" name="fake_username_autofill" style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;z-index:-1;" tabindex="-1" autocomplete="username")
          input(type="password" name="fake_password_autofill" style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;z-index:-1;" tabindex="-1" autocomplete="current-password")

          .auth-field
            label(for="email") 📧 Email Address
            input#email(type="email" name="email" placeholder="your@email.com" required autocomplete="chrome-off")

          .auth-field
            label(for="password") 🔐 Password
            input#password(type="password" name="password" placeholder="••••••••" required autocomplete="new-password")

          p.auth-bottom(style="margin-top: -0.35rem; margin-bottom: 0.6rem;")
            a(href="/forgot-password") Forgot password?

          button.auth-submit(type="submit") 🔓 Sign In

        p.auth-bottom(style="margin-top: 1.5rem;")
          | Don't have an account? 
          a(href="/register") Create One

    script.
      (function() {
        function clearAutofill() {
          var em = document.getElementById('email');
          var pw = document.getElementById('password');
          if (em && em.value && !document.activeElement.isSameNode(em)) em.value = '';
          if (pw && pw.value && !document.activeElement.isSameNode(pw)) pw.value = '';
        }
        window.addEventListener('pageshow', clearAutofill);
        document.addEventListener('DOMContentLoaded', function() {
          clearAutofill();
          setTimeout(clearAutofill, 50);
          setTimeout(clearAutofill, 250);
        });
      })();
