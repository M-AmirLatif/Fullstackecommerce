extends ../layout


block content
  .auth-page
    .auth-shell(data-stagger="90")
      .auth-left(data-reveal="up")
        h1.auth-hero-title ✨ Create Your Account
        p.auth-hero-sub Join thousands of happy customers! Sign up to save your cart, checkout faster, and track your orders.
        .auth-perks
          .perk ✓ Secure encrypted login
          .perk ✓ Persistent shopping cart
          .perk ✓ Order history & tracking
          .perk ✓ Wishlist features
          .perk ✓ Special offers & rewards

      .auth-card(data-reveal="scale")
        .auth-brand-badge(style="display: flex; justify-content: center; margin-bottom: 1rem;")
          .brand-logo-wrap(style="width: 48px; height: 48px; border-radius: 50%; padding: 2.5px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(249, 115, 22, 0.5);")
            img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        h2.auth-title Create Account
        p.auth-subtitle Sign up takes less than a minute!

        if flash
          .flash(class=flash.type)= flash.text

        form.auth-form(action="/register/start" method="POST" autocomplete="off")
          .auth-field
            label(for="name") 👤 Full Name
            input#name(type="text" name="name" placeholder="John Doe" required)

          .auth-field
            label(for="email") 📧 Email Address
            input#email(type="email" name="email" placeholder="your@email.com" required autocomplete="off")

          .auth-field
            label(for="password") 🔐 Password
            input#password(type="password" name="password" placeholder="Create a strong password" required autocomplete="new-password")

          button.auth-submit(type="submit") ✅ Create Account

        p.auth-bottom
          | Already have an account? 
          a(href="/login") Sign In
