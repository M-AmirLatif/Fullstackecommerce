extends ../layout

block content
  .auth-page
    .auth-shell(data-stagger="90")
      .auth-left(data-reveal="up")
        h1.auth-hero-title Forgot Password?
        p.auth-hero-sub Enter your account email and we will send a secure reset link.
        .auth-perks
          .perk(data-reveal="fade") Reset link expires automatically
          .perk(data-reveal="fade") Existing password stays active until reset
          .perk(data-reveal="fade") Email is not disclosed if no account exists

      .auth-card(data-reveal="scale")
        .auth-brand-badge(style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem;")
          .brand-logo-wrap(style="width: 44px; height: 44px; border-radius: 50%; padding: 2px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(249, 115, 22, 0.45); flex-shrink: 0;")
            img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
          .brand-text-group(style="text-align: left;")
            .brand-title(style="display: flex; align-items: baseline; gap: 0.15rem; line-height: 1.1;")
              span.brand-name(style="font-size: 1.22rem; font-weight: 900; color: #fff; letter-spacing: -0.02em;") Tech Innovation
              span.brand-pk(style="color: #f97316; font-size: 1.22rem; font-weight: 900;") .pk
            span.brand-motto(style="font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); display: block; margin-top: 2px;") We Deliver Best
        h2.auth-title Reset Password
        p.auth-subtitle Receive a password reset link by email

        if flash
          .flash(class=flash.type)= flash.text

        form.auth-form(action="/forgot-password" method="POST" autocomplete="off")
          .auth-field
            label(for="email") Email Address
            input#email(type="email" name="email" placeholder="your@email.com" required autocomplete="email")

          button.auth-submit(type="submit") Send Reset Link

        p.auth-bottom
          a(href="/login") Back to Login
