extends ../layout

block content
  .container.cart-page-container(style="padding-top: 2.25rem; margin-top: 1.25rem;")
    nav.breadcrumbs(style="margin-top: 1.75rem; margin-bottom: 2rem;")
      a(href="/") Home
      span.sep /
      span Cart
    h1.page-title(data-reveal="up") Your Shopping Cart

    if !cart || cart.length === 0
      .card.empty-cart-card(data-reveal="up")
        .text-center(style="padding: 2.5rem 1rem;")
          .empty-cart-icon(style="font-size: 3rem; margin-bottom: 1rem;") 🛒
          h3 Your cart is empty
          p(style="color: var(--muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;") Looks like you haven't added any items to your cart yet. Time to explore our collection!
          a.btn(href="/shop") Continue Shopping
    else
      .cart-grid(data-stagger="80")
        .card.cart-items-card(data-reveal="up")
          .card-header-row(style="margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;")
            h3(style="margin: 0;") Order Items (#{cart.length} item#{cart.length !== 1 ? 's' : ''})
          .cart-items-list
            each item in cart
              .cart-item
                .cart-item-img-wrap
                  img.cart-img(src=imageUrl(item.image), alt=item.name, loading="lazy")
                .cart-item-details
                  .cart-item-top
                    .cart-item-meta
                      strong.cart-item-title= item.name
                      span.cart-item-unit-price $#{(item.price || 0).toFixed(2)} each
                    form.cart-remove-form(action="/cart/remove" method="POST" onsubmit="return confirm('Remove this item from your cart?')")
                      input(type="hidden" name="productId" value=item._id)
                      button.btn-remove(type="submit" title="Remove item" aria-label="Remove item")
                        span.remove-icon 🗑️
                        span.remove-text Remove
                  .cart-item-bottom
                    .qty-stepper
                      form(action="/cart/update" method="POST")
                        input(type="hidden" name="productId" value=item._id)
                        input(type="hidden" name="quantity" value=(item.quantity - 1))
                        button.qty-btn(type="submit" aria-label="Decrease quantity") −
                      span.qty-value #{item.quantity}
                      form(action="/cart/update" method="POST")
                        input(type="hidden" name="productId" value=item._id)
                        input(type="hidden" name="quantity" value=(item.quantity + 1))
                        button.qty-btn(type="submit" aria-label="Increase quantity") +
                    .cart-item-subtotal
                      span.subtotal-label Total:
                      strong.subtotal-amount $#{((item.price || 0) * item.quantity).toFixed(2)}

        .card.cart-summary-card(data-reveal="up")
          h3.summary-card-title Order Summary
          .summary-list
            .summary-item
              span Subtotal
              strong $#{(total * 0.9).toFixed(2)}
            .summary-item
              span Estimated Tax (10%)
              span $#{(total * 0.1).toFixed(2)}
            .summary-item
              span Shipping
              span.badge.badge-trust FREE
            .summary-item
              span Delivery estimate
              span.text-muted 3–5 business days
            .summary-total
              span Total
              strong.total-price $#{total.toFixed(2)}
          .summary-actions
            a.btn.btn-checkout(href="/checkout") Proceed to Checkout →
            a.btn.btn-outline(href="/shop") Continue Shopping
