- const safePath = currentPath || ''
- const count = cartCount || 0

// Top Announcement Bar
.top-announcement-bar
  .announcement-inner
    .announcement-left.announcement-desktop
      span.announcement-badge ⚡ TECH INNOVATION
      span.announcement-text We Deliver Best • Free Express Shipping on orders over Rs. 2,000 🇵🇰
    .announcement-mobile
      span.announcement-mobile-text ⚡ Free Express Shipping on orders over Rs. 2,000 • We Deliver Best 🇵🇰
    .announcement-right
      a.announcement-link(href="/contact") 📞 WhatsApp: +92 300 1234567
      span.announcement-divider |
      a.announcement-link(href="/faqs") Help & FAQs

// Main Header Bar
header.site-header
  .header-main-wrap
    .header-main-container
      // Brand Identity
      a.brand(href="/" aria-label="Tech Innovation Store Home")
        .brand-logo-wrap
          img.brand-logo-img(src="/images/logo.png" alt="Tech Innovation Logo" loading="eager")
        .brand-text-group
          .brand-title
            span.brand-name Tech Innovation
            span.brand-pk .pk
          span.brand-motto We Deliver Best

      // Main Search Bar
      form.header-search-form(action="/shop" method="GET")
        .search-input-wrap
          span.search-icon 🔍
          input#headerSearch(
            type="search"
            name="q"
            placeholder="Search smartphones, headphones, smartwatches, gadgets..."
            autocomplete="off"
            aria-label="Search tech products"
          )
          button.search-submit-btn(type="submit" aria-label="Search") Search

      // Right Action Hub
      .header-actions
        a.header-action-btn.action-deals(href="/shop?featured=true")
          span.action-icon 🔥
          span.action-label Deals

        if user && user.role === 'admin'
          a.header-action-btn.action-admin(href="/admin")
            span.action-icon 🛡️
            span.action-label Admin

        if user
          .user-logged-hub(style="display: inline-flex; align-items: center; gap: 0.4rem;")
            .user-menu-pill(style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.75rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; color: #fff; font-size: 0.85rem; font-weight: 700;")
              span.user-avatar 👤
              span.user-name= (user && user.name) ? String(user.name).split(' ')[0] : 'Account'
            form.header-logout-form(action="/logout" method="POST" style="margin: 0;")
              if csrfToken
                input(type="hidden" name="_csrf" value=csrfToken)
              button.header-logout-pill(type="submit" style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.85rem; background: #dc2626; color: #fff; font-weight: 800; font-size: 0.82rem; border-radius: 999px; border: 1px solid #ef4444; cursor: pointer; box-shadow: 0 2px 10px rgba(220,38,38,0.4); transition: transform 0.15s ease, background 0.15s ease;" onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'")
                span 🚪
                span Log Out
        else
          a.header-action-btn.action-user(href="/login")
            span.action-icon 👤
            span.action-label Sign In

        if !user || user.role !== 'admin'
          a.cart-pill-btn(href="/cart" aria-label="View Shopping Cart")
            span.cart-icon 🛒
            span.cart-label Cart
            span.cart-counter(class=(count > 0 ? 'has-items' : ''))= count

        // Mobile Menu Button
        button.nav-toggle-btn(type="button" aria-label="Toggle navigation menu")
          span.toggle-bar
          span.toggle-bar
          span.toggle-bar

  - const currentCat = query && query.category ? String(query.category).toLowerCase() : ''
  - const isDeals = query && (query.featured === 'true' || query.deals === 'true')
  - const isShopAll = safePath === '/shop' && !currentCat && !isDeals && !(query && query.q)

  // Category Sub-Navigation Bar
  nav.category-subnav
    .category-subnav-container
      a.subnav-link(class=(safePath === '/' ? 'active' : '') href="/")
        span 🏠
        span Home
      a.subnav-link(class=(isShopAll ? 'active' : '') href="/shop")
        span ⚡
        span Shop All
      a.subnav-link(class=(isDeals ? 'active' : '') href="/shop?featured=true")
        span 🔥
        span Hot Deals
      a.subnav-link(class=(['smartphones', 'smartphone', 'phones', 'phone'].includes(currentCat) ? 'active' : '') href="/shop?category=Smartphones")
        span 📱
        span Smartphones
      a.subnav-link(class=(['audio', 'audio & sound', 'sound', 'headphones'].includes(currentCat) ? 'active' : '') href="/shop?category=Audio")
        span 🎧
        span Audio & Sound
      a.subnav-link(class=(['wearables', 'wearable', 'smartwatches', 'smartwatch', 'watches'].includes(currentCat) ? 'active' : '') href="/shop?category=Wearables")
        span ⌚
        span Smartwatches
      a.subnav-link(class=(['accessories', 'accessory'].includes(currentCat) ? 'active' : '') href="/shop?category=Accessories")
        span 🔌
        span Accessories
      a.subnav-link(class=(safePath === '/about' ? 'active' : '') href="/about")
        span ℹ️
        span About Us
      a.subnav-link(class=(safePath === '/contact' ? 'active' : '') href="/contact")
        span 💬
        span Contact

  // Mobile Slide-Down Drawer
  .mobile-drawer#mobileDrawer
    .mobile-drawer-content
      .mobile-drawer-brand(style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.08);")
        .brand-logo-wrap(style="width: 36px; height: 36px; border-radius: 50%; padding: 2px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 12px rgba(249, 115, 22, 0.45); flex-shrink: 0;")
          img(src="/images/logo.png" alt="Tech Innovation Logo" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        .brand-text-group
          .brand-title(style="display: flex; align-items: baseline; gap: 0.15rem; line-height: 1.1;")
            span.brand-name(style="font-size: 1.1rem; font-weight: 900; color: #fff;") Tech Innovation
            span.brand-pk(style="color: #f97316; font-size: 1.1rem; font-weight: 900;") .pk
          span.brand-motto(style="font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6);") We Deliver Best

      form.mobile-drawer-search(action="/shop" method="GET")
        input(type="search" name="q" placeholder="Search gadgets, accessories..." autocomplete="off")
        button.btn(type="submit") Search

      .mobile-drawer-section
        p.drawer-kicker CATEGORIES
        .mobile-drawer-grid
          a.drawer-chip(class=(safePath === '/' ? 'active' : '') href="/") 🏠 Home
          a.drawer-chip(class=(isShopAll ? 'active' : '') href="/shop") ⚡ Shop All
          a.drawer-chip(class=(isDeals ? 'active' : '') href="/shop?featured=true") 🔥 Hot Deals
          a.drawer-chip(class=(['smartphones', 'smartphone', 'phones', 'phone'].includes(currentCat) ? 'active' : '') href="/shop?category=Smartphones") 📱 Smartphones
          a.drawer-chip(class=(['audio', 'audio & sound', 'sound', 'headphones'].includes(currentCat) ? 'active' : '') href="/shop?category=Audio") 🎧 Audio
          a.drawer-chip(class=(['wearables', 'wearable', 'smartwatches', 'smartwatch', 'watches'].includes(currentCat) ? 'active' : '') href="/shop?category=Wearables") ⌚ Wearables
          a.drawer-chip(class=(['accessories', 'accessory'].includes(currentCat) ? 'active' : '') href="/shop?category=Accessories") 🔌 Accessories
          a.drawer-chip(class=(safePath === '/about' ? 'active' : '') href="/about") ℹ️ About Us
          a.drawer-chip(class=(safePath === '/contact' ? 'active' : '') href="/contact") 💬 Contact

      .mobile-drawer-section
        p.drawer-kicker ACCOUNT & HELP
        .mobile-drawer-list
          if user
            .mobile-user-card
              span.avatar 👤
              span.name Logged in as #{(user && user.name) ? user.name : (user && user.email) ? user.email : 'User'}
            if user.role === 'admin'
              a.drawer-link(href="/admin") 🛡️ Admin Dashboard
            else
              a.drawer-link(href="/cart") 🛒 View Cart (#{count})
              a.drawer-link(href="/checkout") 💳 Checkout
            form.mobile-logout-form(action="/logout" method="POST" style="margin-top: 0.75rem;")
              if csrfToken
                input(type="hidden" name="_csrf" value=csrfToken)
              button.btn(type="submit" style="background: #dc2626; color: #fff; font-weight: 800; width: 100%; border-radius: 8px; padding: 0.75rem 1rem; border: none; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4); display: flex; align-items: center; justify-content: center; gap: 0.45rem;")
                span 🚪
                span Log Out
          else
            a.btn(href="/login") 👤 Sign In / Register
            a.btn.btn-outline(href="/cart") 🛒 View Cart (#{count})

