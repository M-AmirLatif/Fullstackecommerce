footer.site-footer
  .footer-top.container
    .footer-brand.footer-col(data-reveal="up")
      a.footer-logo(href="/" style="display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none;")
        .brand-logo-wrap(style="width: 38px; height: 38px; border-radius: 50%; padding: 2px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 0 12px rgba(249, 115, 22, 0.45); flex-shrink: 0;")
          img(src="/images/logo.png" alt="Tech Innovation.pk" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #000;")
        span(style="font-size: 1.25rem; font-weight: 800; color: #fff;") Tech Innovation<span style="color: #f97316;">.pk</span>
      p.footer-tagline
        | We Deliver Best — Your premier destination for next-gen electronics, smart accessories, and cutting-edge tech gadgets with guaranteed quality.
      .footer-socials
        a.social-link(href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook") FB
        a.social-link(href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram") IG
        a.social-link(href="https://whatsapp.com" target="_blank" rel="noopener" aria-label="WhatsApp") WA
        a.social-link(href="/contact" aria-label="Contact") ✉

    .footer-col(data-reveal="up" data-reveal-delay="60")
      h4.footer-title Navigation
      ul.footer-links
        li
          a(href="/") Home
        li
          a(href="/shop") All Products
        li
          a(href="/about") About Us
        li
          a(href="/contact") Contact Us
        li
          a(href="/faqs") FAQs

    .footer-col(data-reveal="up" data-reveal-delay="120")
      h4.footer-title Customer Care
      ul.footer-links
        li
          a(href="/shipping") Shipping Info
        li
          a(href="/returns") Returns & Refunds
        li
          a(href="/privacy") Privacy Policy
        li
          a(href="/terms") Terms & Conditions

    .footer-col(data-reveal="up" data-reveal-delay="180")
      h4.footer-title Top Categories
      ul.footer-links
        li
          a(href="/shop?category=Electronics") Electronics & Audio
        li
          a(href="/shop?category=Accessories") Smart Accessories
        li
          a(href="/shop?category=Clothing") Lifestyle & Wear
        li
          a(href="/shop?featured=true") Special Deals

    .footer-col.footer-address(data-reveal="up" data-reveal-delay="240")
      h4.footer-title Contact & Support
      ul.footer-contact
        li
          span.contact-icon 📍
          span Tech Innovation Store, Pakistan
        li
          span.contact-icon ✉
          a(href="mailto:support@techinnovation.pk") support@techinnovation.pk
        li
          span.contact-icon 📞
          a(href="tel:+923001234567") +92 300 1234567
        li
          span.contact-icon ⚡
          span Motto: We Deliver Best

  .footer-bottom(data-reveal="fade")
    .container.footer-bottom-inner
      p.footer-copy
        | © 2026 Tech Innovation.pk — We Deliver Best. All Rights Reserved.
      .footer-mini-links
        a(href="/terms") Terms of Service
        span.footer-dot •
        a(href="/privacy") Privacy Policy
        span.footer-dot •
        a(href="/contact") Support Center
